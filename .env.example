# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_USERNAME=your_bot_username
WEBHOOK_URL=
# e.g. https://bot.reddevils.co.in/webhook  (leave empty for local polling)
WEBHOOK_SECRET=change-me-to-random-32-chars
WEBHOOK_PATH=/webhook

# --- Admins / logging ---
# Comma-separated Telegram user IDs, e.g. "111111111,222222222"
ADMIN_IDS=
LOG_CHANNEL_ID=
# e.g. -1001234567890 (bot must be admin in log channel)

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
DB_PATH=data/bot.db
ENV=dev

# --- Moderation defaults (per-chat overridable later) ---
WARN_LIMIT=3
FLOOD_LIMIT=5
FLOOD_WINDOW_SEC=10
CAPTCHA_TIMEOUT_SEC=90
ALLOW_LINKS=false
WHITELIST_DOMAINS=t.me,telegram.me
BLACKLIST_WORDS=
